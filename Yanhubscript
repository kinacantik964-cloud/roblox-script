-- ==========================================
-- 4. UTILITIES TABS (Pergerakan)
-- ==========================================
local UtilTab = Window:CreateFolder("Utilities")

UtilTab:Toggle("Invisible", function(state)
    if state then
        LocalPlayer.Character.LowerTorso.Root:Destroy() -- Contoh dasar break joints untuk invisinle (tergantung game)
    end
end)

UtilTab:Toggle("No Clip", function(state)
    _G.NoClip = state
    RunService.Stepped:Connect(function()
        if _G.NoClip and LocalPlayer.Character then
            for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
end)

UtilTab:Toggle("Fullbright & No Fog", function(state)
    if state then
        game:GetService("Lighting").Ambient = Color3.fromRGB(255, 255, 255)
        game:GetService("Lighting").FogEnd = 999999
    else
        game:GetService("Lighting").ResetToAtmosphere -- Kembali ke standar game
    end
end)
