-- ==========================================
-- 3. VISUAL / ESP TABS (Melihat Objek)
-- ==========================================
local VisualTab = Window:CreateFolder("Visual & ESP")

local function CreateESP(object, color, text)
    if object and not object:FindFirstChild("Yanhub_ESP") then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "Yanhub_ESP"
        Highlight.FillColor = color
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.Parent = object
        
        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "Yanhub_Label"
        Billboard.Size = UDim2.new(0, 100, 0, 50)
        Billboard.AlwaysOnTop = true
        
        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = color
        Label.TextSize = 14
        Label.Parent = Billboard
        Billboard.Parent = object
    end
end

